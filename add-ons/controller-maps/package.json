{
  "name": "controller-maps",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Controller Maps, a LUNA Add On built with @uaudio/luna-builder-sdk",
  "scripts": {
    "bundle": "tsx scripts/build-bundle.ts",
    "build": "npm run bundle && tsc && vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "ua-builder serve",
    "install-addon": "npm run build && ua-builder install",
    "pack": "npm run build && ua-builder pack"
  },
  "devDependencies": {
    "@uaudio/luna-builder-sdk": "file:../../vendor/luna-builder-sdk",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "yaml": "2.8.1",
    "zod": "3.25.76"
  }
}
